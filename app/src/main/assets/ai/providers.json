            "button"
          ],
          "itemText": "^(Фото|Файлы)$",
          "input": [
            "input[type=file][accept*='image']",
            "input[type=file]"
          ],
          "doneWhen": [
            "[class*='Attachment'] img",
            "[class*='InputFile']",
            "[class*='Preview'] img",
            "[class*='attachment']",
            "img[src^='blob:']"
          ]
        },
        {
          "do": "type",
          "selectors": [
            "[data-testid='inputbase-textarea']",
            "textarea.AliceInput-Textarea",
