            "[class*='Message']"
          ],
          "srcPattern": "(avatars\\.mds\\.yandex\\.net|yandex\\.net|yastatic|^blob:|^data:image)",
          "busy": [
            "[data-testid*='stop' i]",
            "[class*='Typing']",
            "[class*='Generating']",
            "[class*='Loader']"
          ],
          "rewrite": [
            [
              "(avatars\\.mds\\.yandex\\.net/get-[^/]+/[^/]+/[^/?]+)/[^/?]+",
              "$1/orig"
            ]
          ],
          "timeout": 300000
        }
      ]
    },
