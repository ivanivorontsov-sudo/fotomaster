{
  "version": 1,
  "note": "Селекторы для автоматизации чатов. Если сайт поменял вёрстку, правьте только этот файл. Каждый список проверяется по порядку, берётся первый видимый элемент. Поле text задаёт регулярное выражение по видимому тексту кнопки.",
  "providers": [
    {
      "id": "qwen",
      "title": "Qwen",
      "loginUrl": "https://chat.qwen.ai/auth?action=signin",
      "startUrl": "https://chat.qwen.ai/",
      "returnsImage": "Да: в Qwen редактирование фото — это режим «Создать изображение» (+ → Создать изображение) с прикреплённым фото и запросом; в ответе приходит новая картинка. Есть дневной лимит.",
      "loggedIn": {
        "absent": [
          "a[href*='/auth']",
          "button.login-button",
          "[class*='sign-in']"
        ],
        "absentText": "^(Войти|Sign in|Log in|Login)$"
      },
      "steps": [
        {
          "do": "wait",
          "selectors": [
            "textarea.message-input-textarea",
            "#chat-input",
            "textarea",
            "[contenteditable=true]"
          ],
          "timeout": 90000
        },
        {
          "do": "dismiss",
          "selectors": [
            ".ant-drawer-open button",
            ".ant-modal-wrap button",
            "[role=dialog] button"
          ],
          "text": "^(Continue|Продолжить|Got it|Понятно|OK|Принять|Accept|Skip|Пропустить)$"
        },
        {
          "do": "mode",
          "name": "Создать изображение",
          "active": [
            ".chat-input-feature-tag[class*='image']",
            "[class*='feature-tag'][class*='image']",
            "[class*='feature-tag'][class*='t2i']"
          ],
          "activeText": "(создать изображение|create image|image generation|генерация изображ|модель \\d|model \\d)",
          "open": [
            "button[class*='plus']",
            "[class*='plus-btn']",
            "[class*='input-plus']",
            "[class*='add-btn']",
            "button[aria-label*='Загрузить']",
            "button[aria-label*='Добав']",
            "button[aria-label*='upload' i]",
            "button[aria-label*='add' i]",
            "button[aria-label*='more' i]",
            "[class*='mode-select-plus']"
          ],
          "item": [
            "[role=menuitem]",
            "[role=option]",
            "[role=menuitemcheckbox]",
            "[class*='sheet'] li",
            "[class*='drawer'] li",
            "[class*='popup'] li",
            "[class*='menu'] li",
            "[class*='item']",
            "li",
            "button",
            "[role=button]",
            "div",
            "span"
          ],
          "itemText": "^(создать изображение|create image|image generation|generate image|генерация изображений|图像生成|生成图像)$",
          "urlActivates": "",
          "optional": true,
          "askUserOnFail": true,
          "closeAfter": true
        },
        {
          "do": "upload",
          "open": [
            "button[class*='plus']",
            "[class*='plus-btn']",
            "[class*='input-plus']",
            "[class*='add-btn']",
            "button[aria-label*='Загрузить']",
            "button[aria-label*='Добав']",
            "button[aria-label*='upload' i]",
            "button[aria-label*='add' i]",
            "button[aria-label*='more' i]",
            "[class*='mode-select-plus']"
          ],
          "gridAfterText": "^(Загрузить|Upload|上传)$",
          "gridIndex": [
            1,
            3
          ],
          "item": [
            "button[aria-label*='изображ' i]",
            "button[aria-label*='image' i]",
            "button[aria-label*='photo' i]",
            "button[aria-label*='фото' i]",
            "[role=menuitem]",
            "li",
            "button"
          ],
          "itemText": "^(Изображение|Фото|Галерея|Image|Photo|Upload Image|Загрузить изображение|上传图片)$",
          "input": [
            "input[type=file][accept*='image']",
            "input[type=file]"
          ],
          "doneWhen": [
            "[class*='file-item'] img",
            "[class*='upload'] img",
            "[class*='image-preview']",
            "[class*='file-card']",
            "img[src^='blob:']"
          ]
        },
        {
          "do": "type",
          "selectors": [
            "textarea.message-input-textarea",
            "#chat-input",
            "textarea",
            "[contenteditable=true]"
          ]
        },
        {
          "do": "send",
          "selectors": [
            "button.send-button",
            "#send-message-button",
            "button[class*='send']",
            "button[aria-label*='Отправ']",
            "button[aria-label*='send' i]"
          ],
          "enterFallback": true,
          "composer": true
        },
        {
          "do": "dismiss",
          "selectors": [
            ".ant-drawer-open button",
            ".ant-modal-wrap button"
          ],
          "text": "^(Continue|Продолжить|OK)$",
          "resend": true
        },
        {
          "do": "result",
          "containers": [
            ".response-message-content",
            "[class*='response-message']",
            "[class*='chat-response']",
            "[class*='message-content']"
          ],
          "srcPattern": "(cdn\\.qwenlm\\.ai|alicdn\\.com|aliyuncs\\.com|qwen|wanx|^blob:|^data:image)",
          "busy": [
            "button.stop-button",
            "[class*='stop-button']",
            "[class*='generating']",
            "[class*='loading-image']"
          ],
          "rewrite": [
            [
              "\\?x-oss-process=[^#]*$",
              ""
            ]
          ],
          "timeout": 300000
        }
      ]
    },
    {
      "id": "alice",
      "title": "Алиса AI",
      "loginUrl": "https://passport.yandex.ru/auth?retpath=https%3A%2F%2Falice.yandex.ru%2F",
      "startUrl": "https://alice.yandex.ru/",
      "returnsImage": "Да: Алиса AI редактирует загруженное фото прямо в чате (JPEG/PNG до 20 МБ). В часы нагрузки генерация картинок без Алисы Плюс может быть недоступна.",
